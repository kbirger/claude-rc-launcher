{
  "name": "claude-rc-launcher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/src/index.ts",
    "test": "bun test server web/src ./cli",
    "typecheck": "tsc --noEmit",
    "start": "bun server/src/index.ts",
    "build:web": "bun run --cwd web build",
    "build:bundle": "bun run build:web && bun scripts/gen-embed.ts",
    "build": "bun run build:bundle && bun build --compile server/src/index.ts --outfile dist/claude-rc-launcher"
  },
  "dependencies": {
    "@peculiar/x509": "^3.1.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "openid-client": "^6.8.9",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}

{
  "name": "claude-rc-launcher",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/src/index.ts",
    "test": "bun test server ./cli && bun run --cwd web test",
    "typecheck": "tsc --noEmit",
    "start": "bun server/src/index.ts",
    "dev:local": "bun --watch server/src/index.ts --config .local-data/config.toml --local",
    "start:local": "bun server/src/index.ts --config .local-data/config.toml --local",
    "build:web": "bun run --cwd web build",
    "build:bundle": "bun run build:web && bun scripts/gen-embed.ts",
    "build:cli": "bun build --compile --define \"BUILD_VERSION=\\\"$(bun scripts/version.ts)\\\"\" cli/src/index.ts --outfile dist/claude-rc",
    "build:win": "bun build --compile --target=bun-windows-x64 --define \"BUILD_VERSION=\\\"$(bun scripts/version.ts)\\\"\" server/src/index.win.ts --outfile dist/claude-rc-launcher-win-x64.exe",
    "build": "bun run build:bundle && bun build --compile --define \"BUILD_VERSION=\\\"$(bun scripts/version.ts)\\\"\" server/src/index.ts --outfile dist/claude-rc-launcher"
  },
  "dependencies": {
    "@peculiar/x509": "^3.1.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "openid-client": "^6.8.9",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "git-cliff": "2.14.2",
    "typescript": "^7.0.2"
  }
}

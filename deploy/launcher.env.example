# Copy to /etc/claude-rc-launcher.env, chmod 600, and edit.
# All values below are placeholders.

# --- Listener ---
PORT=8080
HOST=0.0.0.0
# Public URL users browse to (no path prefix). Redirect URI = PUBLIC_URL/auth/callback
PUBLIC_URL=https://rc.example.com
# Currently accepted but has no effect (forwarded headers are not consulted).
# The proxy must terminate TLS and forward Host; PUBLIC_URL must be the external https URL.
#TRUST_PROXY=true

# --- OIDC (the issuer MUST be https; http:// is only accepted for localhost/127.0.0.1/::1) ---
OIDC_ISSUER=https://auth.example.com/application/o/claude-rc/
# INSECURE, do not use in production: allow a non-loopback http:// issuer. ID tokens are not
# signature-verified, so a network attacker could forge logins (= root-level execution).
#OIDC_ALLOW_INSECURE=true
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# --- Filesystem ---
# Colon-separated ABSOLUTE directories users may browse/start in. Default: SERVICE_HOME.
#ROOTS=/srv/claude/projects

# --- systemd ---
# system (default) or user. User scope: units omit User= and use WantedBy=default.target; the
# launcher must run as that user with linger enabled and XDG_RUNTIME_DIR=/run/user/<uid>.
# Not verified on a real host.
#SYSTEMD_SCOPE=system
# Default: /etc/systemd/system (system) or SERVICE_HOME/.config/systemd/user (user)
#UNIT_DIR=/etc/systemd/system

# --- Generated instances ---
# User= in each generated unit. Default: root
#SERVICE_USER=root
# HOME for instances. Default: /root for root, else /home/<SERVICE_USER>
#SERVICE_HOME=/root
# PATH for instances. Default: SERVICE_HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#SERVICE_PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
# Path to an ssh-agent socket; if set, passed to every generated unit, otherwise omitted.
#SSH_AUTH_SOCK=/run/ssh-agent.sock
# Claude binary. Must be an ABSOLUTE path (systemd does not search PATH for ExecStart).
# Default: SERVICE_HOME/.local/bin/claude
#CLAUDE_BIN=/root/.local/bin/claude
# Args after "remote-control --name <name>", whitespace-separated.
#CLAUDE_RC_ARGS=--spawn same-dir --no-create-session-in-dir
# Prefix for the default --name (default name = prefix + directory basename)
#NAME_PREFIX=myhost-

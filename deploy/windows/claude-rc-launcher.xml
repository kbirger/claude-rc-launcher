<!--
  WinSW definition of the claude-rc-launcher node service. install.ps1 copies this file to
  claude-rc-launcher-svc.xml next to WinSW (claude-rc-launcher-svc.exe) and fills in the two values marked with @ signs.
  WinSW starts the launcher script, which starts claude-rc-launcher.exe, and reports the service state to Windows.
  This file is the Windows counterpart of deploy/claude-rc-launcher.service.

  The next line is the version of this definition. Raise it whenever this file, the launcher script or the WinSW
  program changes in a way that an old installation must get. See server/src/win/definition.ts.
-->
<!-- claude-rc-service-definition: 1 -->
<service>
  <id>claude-rc-launcher</id>
  <name>Claude RC Launcher (node)</name>
  <description>Node agent of claude-rc-launcher: starts claude remote-control sessions for a hub.</description>

  <!--
    WinSW 2.x has no start hook, so it runs a launcher that rolls back an update that does not stay up and then
    starts the agent (see claude-rc-launcher-run.ps1). The launcher returns the agent's exit code.
  -->
  <executable>powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "%BASE%\claude-rc-launcher-run.ps1" -Exe "%BASE%\claude-rc-launcher.exe" -Config "@CONFIG@" -DataDir "@DATA_DIR@"</arguments>

  <!-- Restart=always, RestartSec=5 -->
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="5 sec"/>
  <resetfailure>1 hour</resetfailure>

  <!-- Give the agent time to end its instances before WinSW ends the process tree. -->
  <stoptimeout>15 sec</stoptimeout>

  <logpath>@DATA_DIR@\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>

[Unit]
Description=Claude RC Launcher (web UI for claude remote-control)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User defaults to root, which is needed to write /etc/systemd/system.
# You may change it (uncomment and edit) e.g. to a dedicated user together with
# scope = "user" in config.toml and linger enabled; see the README. User scope additionally needs
# `loginctl enable-linger <user>` and Environment=XDG_RUNTIME_DIR=/run/user/<uid> here so that
# `systemctl --user` can reach the user bus. Not verified on a real host.
#User=root
ExecStart=/usr/local/bin/claude-rc-launcher --config /etc/claude-rc-launcher/config.toml
StateDirectory=claude-rc-launcher
StateDirectoryMode=0700
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
